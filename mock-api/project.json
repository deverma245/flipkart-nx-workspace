{
  "name": "mock-api",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "mock-api/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/mock-api",
        "main": "mock-api/src/index.ts",
        "additionalEntryPoints": [
          "mock-api/src/browser.ts",
          "mock-api/src/server.ts"
        ],
        "tsConfig": "mock-api/tsconfig.lib.json",
        "assets": []
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "mock-api/jest.config.cts"
      }
    }
  }
}